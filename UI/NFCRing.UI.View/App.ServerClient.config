<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy these appSettings into NFCRing.UI.View.exe.config on devices that should
  manage central token configuration through the server/DC.
-->
<appSettings>
    <add key="NFCRing.ServiceHost" value="dc01.example.local"/>
    <add key="NFCRing.RegistrationPort" value="28417"/>
</appSettings>
